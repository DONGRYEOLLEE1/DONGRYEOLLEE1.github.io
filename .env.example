# The final public origin only. No path or trailing slash.
# Vercel falls back to its production project URL when SITE_URL is absent.
SITE_URL=https://dongryeollee1.github.io

# ── 연관 글 추천 동기화 (npm run recommendations:sync) ─────────────────────
# 발행 서버 전용이다. Vercel에는 넣지 않는다. 빌드와 독자 방문 시점에는 아래 값을 쓰지 않는다.
# `recommendations:*` 스크립트가 이 파일(.env)을 읽는다.

# OpenRouter API 키. 관계 추출·재정렬(LLM)과 블록 임베딩에 함께 쓴다.
OPENROUTER_API_KEY=
# 두 발행 서버가 공유하는 블록 벡터 캐시(Supabase pgvector). supabase/block_embeddings.sql 참고.
# 둘 다 비워 두면 로컬 캐시(.cache/embeddings)만 쓰고 다른 서버와 벡터를 공유하지 않는다.
# 둘 중 하나만 넣으면 동기화가 시작되지 않는다.
SUPABASE_URL=
# 서버용 secret 키(sb_secret_…). 브라우저나 PUBLIC_ 변수에 넣지 않는다.
# 예전 형식의 service_role 키는 SUPABASE_SERVICE_ROLE_KEY 로 넣어도 된다.
SUPABASE_SECRET_KEY=

# 선택. 비워 두면 기본값을 쓴다. 두 발행 서버의 값이 같아야 결과가 같다.
# LLM 모델 ID. 기본 openai/gpt-6-luna. 바꾸면 전 글을 다시 추론한다.
# OpenRouter에서는 reasoning·seed·structured outputs를 모두 지원하는 모델만 쓸 수 있다.
RECOMMENDATIONS_MODEL=
# 추론 강도. 기본 low. 바꾸면 전 글을 다시 추론한다.
RECOMMENDATIONS_REASONING_EFFORT=
# LLM 출력 한도(토큰). 기본 8000. 출력 잘림으로 실패한 글이 있을 때 올린다.
RECOMMENDATIONS_MAX_TOKENS=
# LLM 동시 호출 수. 기본 4. 결과에는 영향을 주지 않는다.
RECOMMENDATIONS_CONCURRENCY=
# 임베딩 모델 ID. 기본 google/gemini-embedding-2. 바꾸면 전 블록을 다시 임베딩한다.
EMBEDDINGS_MODEL=
# 임베딩 차원. 기본 768. Supabase 테이블의 vector(768)과 같아야 한다.
EMBEDDINGS_DIMENSIONS=
# OpenRouter 대신 쓸 OpenAI 호환 LLM 엔드포인트와 그 키. 지정하면 temperature 0으로 호출한다.
RECOMMENDATIONS_API_BASE=
RECOMMENDATIONS_API_KEY=
# OpenRouter 대신 쓸 OpenAI 호환 임베딩 엔드포인트와 그 키.
EMBEDDINGS_API_BASE=
EMBEDDINGS_API_KEY=
