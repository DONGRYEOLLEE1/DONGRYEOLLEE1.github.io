          "targetEvidence": {
            "articleId": "book-spine",
            "blockId": "[null,1]",
            "anchor": null,
            "quote": "We built a book-spine reader that runs in a phone browser. It detects and counts the spines in a shelf photo, reads each title and looks it up in a list of 50,000 books. Detection and OCR use three ONNX models (28.3 MB in total) under ONNX Runtime Web, and the lookup uses character n-gram search.",
