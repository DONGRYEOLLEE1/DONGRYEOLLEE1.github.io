---
import type { Concept } from '../lib/types';
import { ARCHIVE_SORT_LABELS, ARTICLE_TYPE_LABELS } from '../lib/archive-copy';
interface Props { concepts: Concept[]; search?: boolean; topicFilter?: boolean }
const { concepts, search = false, topicFilter = true } = Astro.props;
---
<details class="mobile-filter-panel" data-filter-panel open>
  <summary>Filters <span data-selected-filter-count></span></summary>
  <div class="filter-controls">
    {topicFilter && <details class="filter-select">
      <summary>Topics</summary>
      <fieldset class="filter-options"><legend class="sr-only">Topics (select multiple)</legend>
        {concepts.map(concept => <label><input type="checkbox" name="topic" value={concept.id}/><span>{concept.label}</span></label>)}
      </fieldset>
    </details>}
    <details class="filter-select">
      <summary>Article types</summary>
      <fieldset class="filter-options"><legend class="sr-only">Article types (select multiple)</legend>
        {Object.entries(ARTICLE_TYPE_LABELS).map(([id,label]) => <label><input type="checkbox" name="type" value={id}/><span>{label}</span></label>)}
      </fieldset>
    </details>
    <label class="sort-field">Sort by <select name="sort">
      {search && <option value="relevance">{ARCHIVE_SORT_LABELS.relevance}</option>}
      <option value="latest">{ARCHIVE_SORT_LABELS.latest}</option>
    </select></label>
    <button type="button" class="resource-link" data-filter-reset>Clear filters</button>
  </div>
</details>
