---
interface Props { active?: string }
const { active = '' } = Astro.props;
const links = [
  { href: '/articles/', label: '글', id: 'articles' },
  { href: '/topics/', label: '주제', id: 'topics' },
  { href: '/about/', label: '소개', id: 'about' },
];
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="홈" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
      <svg class="wordmark-symbol" width="32" height="32" viewBox="0 0 64 64" aria-hidden="true">
        <path d="M18 15h28v6H24v7h20v6H18V15Zm-4 25h36v6H14v-6Zm18-6h6v8h-6v-8Zm-13 16h27v6H19v-6Z" fill="currentColor"/>
      </svg>
    </a>
    <nav class="nav-links" aria-label="기본 메뉴">
      {links.map(link => <a href={link.href} aria-current={active === link.id ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="icon-button search-toggle" type="button" data-open-search aria-label="글 검색" aria-haspopup="dialog" aria-controls="search-dialog" aria-keyshortcuts="Meta+K Control+K">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.8" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <span class="search-toggle-label">검색</span>
        <kbd aria-hidden="true">⌘K</kbd>
      </button>
      <label class="theme-control">
        <span class="sr-only">화면 테마</span>
        <svg class="theme-symbol" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.4"/>
          <path d="M10 3a7 7 0 0 0 0 14Z" fill="currentColor"/>
        </svg>
        <select id="theme-select" data-theme-choice>
          <option value="system">자동</option><option value="light">밝게</option><option value="dark">어둡게</option>
        </select>
        <svg class="theme-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </label>
      <button class="icon-button mobile-menu-button" type="button" data-menu aria-label="메뉴" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path class="menu-open-symbol" d="M5 8h14M5 16h14"/>
          <path class="menu-close-symbol" d="m6 6 12 12m0-12L6 18"/>
        </svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label="모바일 메뉴" hidden>
    {links.map(link => <a href={link.href} aria-current={active === link.id ? 'page' : undefined}>{link.label}</a>)}
  </nav>
</header>
