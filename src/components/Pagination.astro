---
interface Props { page: number; totalPages: number; basePath?: string; query?: URLSearchParams | Record<string,string> }
const { page, totalPages, basePath = '/articles/', query } = Astro.props;
const link = (n: number) => {
  const params = query instanceof URLSearchParams ? new URLSearchParams(query) : new URLSearchParams(query);
  params.delete('page');
  const root = basePath.replace(/\/+$/, '') + '/';
  const path = params.size ? root : n === 1 ? root : `${root}page/${n}/`;
  if (params.size && n > 1) params.set('page',String(n));
  return path + (params.size ? '?' + params.toString() : '');
};
const visible = Array.from({length:Math.max(0,totalPages)},(_,i) => i+1).filter(n=>n===1||n===totalPages||Math.abs(n-page)<=2);
---
{totalPages > 1 && <nav class="pagination" aria-label="Article pages" lang="en">
  {page > 1 && <a href={link(page-1)} rel="prev" aria-label="Previous page">← Previous</a>}
  {visible.map((n,i) => <>{i>0&&n-visible[i-1]>1&&<span class="pagination-gap" aria-hidden="true">…</span>}<a href={link(n)} class:list={{active:n===page}} aria-current={n===page?'page':undefined} aria-label={`Page ${n}`}>{n}</a></>)}
  {page < totalPages && <a href={link(page+1)} rel="next" aria-label="Next page">Next →</a>}
</nav>}
