---
import type { Article, Concept } from '../lib/types';
interface Props { article: Article; view?: 'list' | 'grid'; concepts?: Concept[] }
const { article, view = 'list', concepts = [] } = Astro.props;
const grid = view === 'grid';
const labels = new Map(concepts.map(concept => [concept.id, concept.label]));
const refs = Array.from(new Set(article.conceptRefs.map(ref => ref.id))).slice(0,3);
---
<article class:list={{ 'archive-card': grid, 'archive-card--text': grid && !article.hero, 'post-row': !grid }} data-article-id={article.id}>
  {grid && article.hero && <a class:list={['archive-card-media', { 'is-photo': article.hero.kind === 'photo' }]} href={article.path} tabindex="-1" aria-hidden="true"><img src={article.hero.src} alt="" loading="lazy" decoding="async" /></a>}
  <header class="post-card-heading">
    <h2 class={grid ? 'archive-card-title' : 'post-title'}><a href={article.path} lang={article.language}>{article.title}</a></h2>
    {article.related.length > 0 && (
      <button class="card-related-trigger" type="button" data-related-open={article.id} aria-label={`${article.title} 관련 글 보기`} aria-haspopup="dialog" aria-controls="related-dialog" aria-expanded="false">···</button>
    )}
  </header>
  {(!grid || !article.hero) && <p class={grid ? 'archive-card-description' : 'post-description'} lang={article.language}>{article.description}</p>}
  {!grid && <div class="topic-chips">{refs.map(id => <a class="chip" href={`/topics/${id}/`}>{labels.get(id) || id}</a>)}</div>}
</article>
