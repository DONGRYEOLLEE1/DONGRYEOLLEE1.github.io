---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getArticles, getConcepts } from '../../lib/content';
import { latestArticles } from '../../lib/page-data';
import { SITE } from '../../lib/site';
const concepts = getConcepts();
const selected = latestArticles(getArticles().filter(article => article.contentType === 'research')).slice(0, 3);
---
<BaseLayout title="About" description="Technical notes by Dongryeol Lee on language models, inference, and AI agents." canonicalPath="/about/" language="en">
  <div class="page-shell about-page">
    <div class="about-layout">
      <aside class="about-aside">
        <h1 class="page-title">Dongryeol Lee</h1>
        <p class="author-role">AI Engineer</p>
        <div class="about-social">
          <a class="arrow-link" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a class="arrow-link" href={SITE.huggingface} target="_blank" rel="noopener noreferrer">Hugging Face ↗</a>
        </div>
      </aside>
      <div class="about-copy">
        <h2>I study language models and build systems with them.</h2>
        <p>I work on language model training and inference, and I build and test AI agents. This blog collects notes from my experiments, implementations, and reading.</p>
        <p>I document the evaluation setup, failed approaches, and differences I see across environments. Older implementation notes reflect the tools and versions in use at the time.</p>
        <section class="about-interests">
          <h3>What I write about</h3>
          <div class="interest-row">
            <h4>LLM Training and Efficiency</h4>
            <p>Fine-tuning, quantization, distillation, and inference efficiency.</p>
          </div>
          <div class="interest-row">
            <h4>Inference and Serving</h4>
            <p>Running models, integrating them into services, and troubleshooting production issues.</p>
          </div>
          <div class="interest-row">
            <h4>Retrieval and AI Agents</h4>
            <p>Improving search results, connecting tools, and evaluating how agents behave.</p>
          </div>
        </section>
        <div class="about-actions"><a class="arrow-link" href="/articles/">View All Articles ↗</a></div>
      </div>
    </div>
    {selected.length > 0 && <section class="about-selected" aria-labelledby="recent-research">
      <div class="section-heading"><h2 id="recent-research">Recent Research</h2></div>
      <div class="post-list">{selected.map(article => <PostCard article={article} concepts={concepts}/>)}</div>
    </section>}
  </div>
</BaseLayout>
