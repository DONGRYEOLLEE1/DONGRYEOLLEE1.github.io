---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ArticleArchive from '../../../../components/ArticleArchive.astro';
import { getArticles, getConcepts } from '../../../../lib/content';
import { latestArticles, usedConcepts } from '../../../../lib/page-data';
interface Props { page: number }
export function getStaticPaths() {
  return Array.from({length:Math.max(0,Math.ceil(getArticles().length/12)-1)},(_,index) => ({params:{page:String(index+2)},props:{page:index+2}}));
}
const { page } = Astro.props;
const articles = latestArticles(getArticles());
const concepts = usedConcepts(articles,getConcepts());
---
<BaseLayout title={`전체 글 · ${page}페이지`} description="연구와 구현, 문제 해결 과정을 날짜순으로 정리했습니다." canonicalPath={`/articles/page/${page}/`}>
  <div class="page-shell archive-page"><header class="page-heading"><h1 class="page-title">전체 글</h1><p class="page-description">연구와 구현, 문제 해결 과정을 날짜순으로 정리했습니다.</p></header><ArticleArchive articles={articles} concepts={concepts} page={page}/></div>
</BaseLayout>
