---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, getConcepts } from '../lib/content';
import { latestArticles, articlesForConcept } from '../lib/page-data';
import type { Concept } from '../lib/types';
const articles = latestArticles(getArticles());
const concepts = getConcepts();
const lead = articles.find(article => article.featured) ?? articles[0];
const recent = articles.filter(article => article.id !== lead?.id).slice(0, 8);
const selectedTopics = ['reasoning-efficiency','korean-ocr','reranking','qlora','speculative-decoding','agent'];
const topics = selectedTopics.map(id => concepts.find(concept => concept.id === id)).filter((concept): concept is Concept => Boolean(concept && articlesForConcept(concept.id,articles,concepts).length > 0));
---
<BaseLayout title="동렬의 기술 블로그" canonicalPath="/">
  <div class="page-shell home-page">
    {!lead && <h1 class="sr-only">동렬의 기술 블로그</h1>}
    {lead && <article class:list={['editorial-feature',{'no-media':!lead.hero}]} aria-labelledby="featured-title">
      <div class="feature-copy">
        <h1 class="feature-title" id="featured-title" lang={lead.language}><a href={lead.path}>{lead.title}</a></h1>
        <p class="feature-description" lang={lead.language}>{lead.description}</p>
        <a class="feature-read" href={lead.path}>글 읽기 <span aria-hidden="true">↗</span></a>
      </div>
      {lead.hero && <a class="feature-media" href={lead.path} aria-labelledby="featured-title" lang={lead.language}><img src={lead.hero.src} alt={lead.hero.alt} width="1200" height="720" fetchpriority="high" class:list={{'is-figure':lead.hero.kind !== 'photo'}}/></a>}
    </article>}
    <div class="home-lower">
      <section aria-labelledby="recent-title">
        <div class="section-heading"><h2 id="recent-title">최근 글</h2><a href="/articles/">전체 글 <span aria-hidden="true">↗</span></a></div>
        <div class="home-entries">
          {recent.map(article => <article>
            <a class="home-entry" href={article.path} lang={article.language} aria-labelledby={`home-${article.id}`}>
              <h3 id={`home-${article.id}`}>{article.title}</h3>
              <span class="home-entry-arrow" aria-hidden="true">↗</span>
              <p class="home-entry-description">{article.description}</p>
            </a>
          </article>)}
        </div>
      </section>
      <aside class="home-topics" aria-labelledby="home-topics-title">
        <div class="section-heading"><h2 id="home-topics-title">주제</h2><a href="/topics/">전체 주제 <span aria-hidden="true">↗</span></a></div>
        <div class="topic-list">{topics.map(concept => <a href={`/topics/${concept.id}/`}><span>{concept.label}</span><span aria-hidden="true">↗</span></a>)}</div>
      </aside>
    </div>
  </div>
</BaseLayout>
