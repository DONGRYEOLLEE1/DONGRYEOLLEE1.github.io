---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getArticles, getConcepts, getProjects } from '../../../lib/content';
import { latestArticles } from '../../../lib/page-data';
import type { Project } from '../../../lib/types';
interface Props { project: Project }
export function getStaticPaths() { return getProjects().map(project => ({params:{id:project.id},props:{project}})); }
const { project } = Astro.props;
const articles = latestArticles(getArticles().filter(article => article.projectIds.includes(project.id)));
const conceptIds = new Set(articles.flatMap(article => article.conceptRefs.map(ref => ref.id)));
const concepts = getConcepts().filter(concept => conceptIds.has(concept.id));
---
<BaseLayout title={project.name} description={project.description} canonicalPath={`/projects/${project.id}/`} image={project.hero?.src}>
  <div class="page-shell project-detail-page"><header class="page-heading"><a class="breadcrumb" href="/projects/">프로젝트 <span aria-hidden="true">/</span></a><h1 class="page-title">{project.name}</h1><p class="page-description">{project.description}</p><div class="project-actions">{project.links.map(link => <a class="arrow-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></header>
    {project.hero && <figure class="project-result"><a href={project.hero.src} data-image-open><img src={project.hero.src} alt={project.hero.alt} width="1200" height="700"/></a><figcaption class="figure-caption">{project.hero.caption || project.hero.alt}</figcaption></figure>}
    {project.body && <section class="project-context" aria-labelledby="project-context-title"><h2 id="project-context-title">접근과 적용 범위</h2>{project.body.split(/\n\s*\n/).map(paragraph => <p>{paragraph}</p>)}</section>}
    {articles.length > 0 && <section class="project-articles"><div class="section-heading"><h2>연구·구현 기록</h2><span class="small-label">{articles.length}개의 글</span></div><p class="project-reading-note">실험 조건과 평가 결과, 한계와 재현 자료는 각 글에서 확인할 수 있습니다.</p><div class="post-list">{articles.map(article => <PostCard article={article} concepts={concepts}/>)}</div></section>}
    {concepts.length > 0 && <aside class="adjacent-topics"><h2>관련 기술</h2><div class="topic-chips">{concepts.map(concept => <a class="chip" href={`/topics/${concept.id}/`}>{concept.label}</a>)}</div></aside>}
    <a class="arrow-link project-back" href="/projects/">다른 프로젝트 보기 ↗</a>
  </div>
</BaseLayout>
