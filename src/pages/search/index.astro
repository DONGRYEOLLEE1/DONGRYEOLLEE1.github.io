---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterFields from '../../components/FilterFields.astro';
import { getArticles, getConcepts } from '../../lib/content';
import { usedConcepts } from '../../lib/page-data';
const concepts = usedConcepts(getArticles(),getConcepts());
---
<BaseLayout title="검색" description="제목, 기술 개념과 본문에서 글을 찾습니다." canonicalPath="/search/" noindex>
  <div class="page-shell full-search-page" data-search-page data-page-size="10">
    <header class="page-heading"><h1 class="page-title">검색</h1><p class="page-description">제목, 기술 개념과 본문에서 글을 찾습니다.</p></header>
    <form class="filter-bar" data-full-search-form action="/search/" method="get" lang="en">
      <div class="search-field">
        <input type="search" name="q" aria-label="Search articles" placeholder="Search titles, topics, or text" autocomplete="off"/>
        <button class="button" type="submit">Search</button>
      </div>
      <FilterFields concepts={concepts} search/>
      <p class="form-error" data-input-error hidden role="alert"></p>
    </form>
    <div class="active-filters" data-active-filters lang="en"></div>
    <div class="full-search-status" data-full-search-status role="status" aria-live="polite" lang="en">Enter a search term.</div>
    <div class="post-list" data-full-search-results></div>
    <div data-full-search-pagination></div>
    <p class="search-topic-link"><a class="arrow-link" href="/topics/">주제로 찾아보기 ↗</a></p>
    <noscript><style is:inline>[data-full-search-form], [data-full-search-status] { display:none; }</style><p>현재 검색을 이용할 수 없어요. 전체 글이나 주제로 찾아보세요.</p><a class="arrow-link" href="/articles/">전체 글 보기 ↗</a></noscript>
  </div>
</BaseLayout>
