---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleArchive from '../../../components/ArticleArchive.astro';
import { getArticles, getConcepts, getSeries } from '../../../lib/content';
import { articlesForConcept } from '../../../lib/page-data';
import type { Concept } from '../../../lib/types';
interface Props { concept: Concept }
export function getStaticPaths() { return getConcepts().map(concept => ({params:{id:concept.id},props:{concept}})); }
const { concept } = Astro.props;
const concepts = getConcepts();
const articles = articlesForConcept(concept.id,getArticles(),concepts);
const broader = concepts.filter(item => concept.broaderIds.includes(item.id));
const children = concepts.filter(item => item.broaderIds.includes(concept.id));
const siblings = concepts.filter(item => item.id !== concept.id && item.broaderIds.some(id => concept.broaderIds.includes(id)) && articlesForConcept(item.id,getArticles(),concepts).length > 0);
const adjacent = [...children,...siblings].slice(0,8);
const articleIds = new Set(articles.map(article => article.id));
const series = getSeries().filter(item => item.orderedArticleIds.filter(id => articleIds.has(id)).length > 1);
const englishAliases = concept.aliases.filter(alias => !/\p{Script=Hangul}/u.test(alias) && alias.toLowerCase() !== concept.label.toLowerCase()).slice(0,5);
---
<BaseLayout title={concept.label} description={concept.description} canonicalPath={`/topics/${concept.id}/`} language="en">
  <div class="page-shell topic-detail-page">
    <header class="page-heading">
      <a class="breadcrumb" href="/topics/">Topics <span aria-hidden="true">/</span></a>
      <h1 class="page-title">{concept.label}</h1>
      {englishAliases.length > 0 && <p class="topic-aliases muted">{englishAliases.join(' · ')}</p>}
      <p class="page-description" lang="ko">{concept.description}</p>
    </header>
    {series.length > 0 && <aside class="topic-series"><span class="small-label">Read in series order</span>{series.map(item => <a href={`/series/${item.id}/`} lang="ko">{item.title} ↗</a>)}</aside>}
    <ArticleArchive articles={articles} concepts={concepts} topicId={concept.id} basePath={`/topics/${concept.id}/`}/>
    {(broader.length > 0 || adjacent.length > 0) && <aside class="adjacent-topics">
      {broader.length > 0 && <div><h2>Broader topics</h2><div class="topic-chips">{broader.map(item => <a class="chip" href={`/topics/${item.id}/`}>{item.label}</a>)}</div></div>}
      {adjacent.length > 0 && <div><h2>Related topics</h2><div class="topic-chips">{adjacent.map(item => <a class="chip" href={`/topics/${item.id}/`}>{item.label}</a>)}</div></div>}
    </aside>}
    <p class="topic-search-note"><a href={`/search/?q=${encodeURIComponent(concept.label)}`}>Search all articles for {concept.label} ↗</a></p>
  </div>
</BaseLayout>
