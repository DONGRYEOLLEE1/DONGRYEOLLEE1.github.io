---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleCountLabel, topicCountLabel } from '../../lib/archive-copy';
import { getArticles, getConcepts } from '../../lib/content';
import { articlesForConcept, usedConcepts, areaId, topicAreaLabel } from '../../lib/page-data';
const articles = getArticles();
const concepts = usedConcepts(articles,getConcepts());
const areas = [...new Set(concepts.map(concept => concept.area))];
---
<BaseLayout title="Topics" description="Browse technical articles by topic." canonicalPath="/topics/" language="en">
  <div class="page-shell topics-page">
    <header class="page-heading"><h1 class="page-title">Topics</h1></header>
    <form class="topic-search" data-topic-form action="/topics/" method="get">
      <label class="search-field">
        <span class="sr-only">Search topics</span>
        <input type="search" name="q" placeholder="Search topics" autocomplete="off"/>
        <button type="submit" class="button">Search</button>
      </label>
      <p class="form-error" data-input-error hidden role="alert"></p>
    </form>
    <nav class="topic-area-nav" aria-label="Topic areas">{areas.map(area => <a href={`#${areaId(area)}`}>{topicAreaLabel(area)}</a>)}</nav>
    <div class="result-line"><span data-topic-results-count aria-live="polite">{topicCountLabel(concepts.length)}</span></div>
    <div class="empty-state" data-topic-empty hidden>
      <h2>No matching topics</h2>
      <p>Try another name or alias.</p>
      <a href="/topics/">View all topics ↗</a>
    </div>
    {areas.map(area => <section class="topic-area-section" data-topic-area={area} aria-labelledby={areaId(area)}>
      <div class="section-heading"><h2 id={areaId(area)}>{topicAreaLabel(area)}</h2></div>
      <div class="topic-grid">{concepts.filter(concept => concept.area === area).map(concept => <article class="topic-tile" data-topic-tile data-topic-id={concept.id} data-search={[concept.label,...concept.aliases].join(' ')}>
        <div class="topic-tile-meta"><span class="small-label">{topicAreaLabel(area)}</span><span>{articleCountLabel(articlesForConcept(concept.id,articles,concepts).length)}</span></div>
        <h3 class="topic-name"><a href={`/topics/${concept.id}/`}>{concept.label}</a></h3>
        <p lang="ko">{concept.description}</p>
        <div class="topic-tile-footer"><a class="arrow-link" href={`/topics/${concept.id}/`}>View articles ↗</a></div>
      </article>)}</div>
    </section>)}
    <noscript><style is:inline>[data-topic-form] { display:none; }</style><p class="noscript-note">Enable JavaScript to search by topic name, or browse the full list below.</p></noscript>
  </div>
</BaseLayout>
